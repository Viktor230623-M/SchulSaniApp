# Konfiguration des Backends fuer eine Instanz.
#
# Datei nach .env kopieren und ausfuellen. .env liegt nicht im Repository.
# Fehlt einer der Pflichtwerte, startet der Server nicht und nennt beim Abbruch,
# was fehlt (siehe src/config.ts).

# --- Pflicht: Betrieb -------------------------------------------------------

# Verbindung zur Postgres-Datenbank dieser Instanz.
DATABASE_URL=postgres://benutzer:passwort@localhost:5432/datenbank

# Port, auf dem der Server lauscht. Nginx reicht die Anfragen dorthin weiter.
PORT=3002

# Signaturschluessel fuer Sitzungs- und Auth-Tokens, mindestens 32 Zeichen.
# Pro Instanz neu erzeugen, z. B. mit: openssl rand -base64 48
JWT_SECRET=

# production oder development. Steuert unter anderem das Secure-Flag am Cookie.
NODE_ENV=production

# --- Pflicht: Instanz -------------------------------------------------------

# Web-Adressen, unter denen die App laeuft; kommagetrennt, jeweils mit Schema.
# Nur https, Ausnahme localhost fuer die Entwicklung. "*" ist nicht zulaessig,
# weil die API mit Cookies arbeitet.
ALLOWED_ORIGINS=https://sani.beispielschule.de

# Lokale Konten und OIDC-Anbieter stehen in AUTH_PROVIDERS_PATH. OIDC-Redirect-URIs
# muessen exakt mit den beim jeweiligen Anbieter registrierten URIs uebereinstimmen.

# Anzeigename der Anwendung dieser Instanz. Unter anderem Rueckfalltitel einer
# Benachrichtigung ohne eigenen Titel.
APP_NAME=SchulSani

# --- Optional ---------------------------------------------------------------

# Cloud-Betrieb: true, wenn diese Instanz mehrere Schulen bedient. Dann kommt
# die Schul-Kennung aus jeder Anfrage (schoolId) und muss in der schools-
# Tabelle existieren; der Zugangscode liegt je Schule vor. Selbsthosting
# (Standard) bedient genau eine Schule und laesst diesen Wert weg.
MULTI_TENANT=false

# Kennung der Schule, die neu angelegten Nutzern zugewiesen wird.
# Ohne Angabe: "school".
SCHOOL_ID=

# Gemeinsamer Zugangscode der Schule. Ist er gesetzt, braucht jedes neue Konto
# (E-Mail-Registrierung und OIDC/Apple-Erst-Login) diesen Code; mit korrektem
# Code wird das Konto sofort freigeschaltet statt auf einen Verwalter zu warten.
# Ohne Angabe ist die Registrierung offen.
SCHOOL_JOIN_CODE=

# Zentrale Callback-Domain fuer OIDC (Relay-Modus), z. B. https://auth.schulsani.app
# Ist sie gesetzt, zeigen alle OIDC-Anmeldewege auf deren /api/auth/<key>/callback
# statt auf die eigene Domain; der state traegt die eigene Herkunft, ueber die
# der Relay den Ruecksprung zurueckleitet. Die Session-Cookies bekommen dann
# das Domain-Attribut dieser Instanz. Ohne Angabe bleibt jede Instanz bei den
# in AUTH_PROVIDERS_PATH registrierten Redirect-URIs.
AUTH_RELAY_BASE_URL=

# Pfad zu einer Bootstrap-Rollenzuordnung fuer die Ersteinrichtung.
# Nur generische Rollen, keine echten Namen.
ROLE_MAP_PATH=

# Pfad zu einer JSON-Liste konfigurierter lokaler oder OIDC-Anmeldewege.
# Ohne Angabe startet die Installation nicht. Lokale Konten brauchen key,
# displayName und type=local; OIDC zusaetzlich issuerUrl, clientId und redirectUri.
AUTH_PROVIDERS_PATH=

# --- E-Mail-Konten ----------------------------------------------------------
# SMTP ist fuer Registrierung, E-Mail-Bestaetigung und Passwort-Reset Pflicht.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Feste Sicherheitsrichtlinie des Installers: STARTTLS wird erzwungen,
# wenn keine direkte TLS-Verbindung (SMTP_SECURE=true) verwendet wird.
SMTP_REQUIRE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME=
# Antworten auf versendete Mails landen hier (z. B. info@schulsaniapp.com).
# Ohne Angabe antworten Empfaenger auf die Absenderadresse.
MAIL_REPLY_TO=
APP_BASE_URL=https://sani.beispielschule.de

# Web-Push (VAPID). Schluesselpaar erzeugen mit:
#   npx web-push generate-vapid-keys
# Der oeffentliche Schluessel gehoert zusaetzlich in die .env der App.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktangabe fuer den Push-Dienst, mailto: oder URL.
VAPID_SUBJECT=mailto:betreuung@beispielschule.de

# Native Push (iOS/Android) laeuft ueber die zentralen APNs-/FCM-Konten des
# Anbieters. Ohne diese Werte versendet der Server keinen nativen Push; Web-Push
# (VAPID oben) bleibt davon unberuehrt.
#
# FCM (Android): Pfad zur Service-Account-JSON aus der Firebase-Konsole, oder
# der Inhalt der Datei direkt als FCM_SERVICE_ACCOUNT. Projekt-ID des Firebase-
# Projekts.
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=

# APNs (iOS): Pfad zum .p8-Auth-Key, dazu Key-ID, Team-ID und Bundle-ID der
# App (z. B. com.schulsani.app). APNS_ENV=sandbox fuer Entwicklung, sonst
# production.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=production

# Resend/Svix-Signatur fuer eingehende Zustellereignisse. Ohne Secret
# verwirft der Webhook alle Anfragen.
RESEND_WEBHOOK_SECRET=

# URL einer LibreTranslate-Instanz fuer Uebersetzungen.
# Ohne Angabe: http://localhost:5000
LIBRETRANSLATE_URL=
