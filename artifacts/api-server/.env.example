# Konfiguration des Backends fuer eine Instanz.
#
# Datei nach .env kopieren und ausfuellen. .env liegt nicht im Repository.
# Fehlt einer der Pflichtwerte, startet der Server nicht und nennt beim Abbruch,
# was fehlt (siehe src/config.ts).

# --- Pflicht: Betrieb -------------------------------------------------------

# Verbindung zur Postgres-Datenbank dieser Instanz.
DATABASE_URL=postgres://benutzer:passwort@localhost:5432/datenbank

# Port, auf dem der Server lauscht. Nginx reicht die Anfragen dorthin weiter.
PORT=3002

# Signaturschluessel fuer Sitzungs- und Auth-Tokens, mindestens 32 Zeichen.
# Pro Instanz neu erzeugen, z. B. mit: openssl rand -base64 48
JWT_SECRET=

# production oder development. Steuert unter anderem das Secure-Flag am Cookie.
NODE_ENV=production

# --- Pflicht: Instanz -------------------------------------------------------

# Web-Adressen, unter denen die App laeuft; kommagetrennt, jeweils mit Schema.
# Nur https, Ausnahme localhost fuer die Entwicklung. "*" ist nicht zulaessig,
# weil die API mit Cookies arbeitet.
ALLOWED_ORIGINS=https://sani.beispielschule.de

# Lokale Konten und OIDC-Anbieter stehen in AUTH_PROVIDERS_PATH. OIDC-Redirect-URIs
# muessen exakt mit den beim jeweiligen Anbieter registrierten URIs uebereinstimmen.

# Anzeigename der Anwendung dieser Instanz. Unter anderem Rueckfalltitel einer
# Benachrichtigung ohne eigenen Titel.
APP_NAME=SchulSani

# --- Optional ---------------------------------------------------------------

# Kennung der Schule, die neu angelegten Nutzern zugewiesen wird.
# Ohne Angabe: "school".
SCHOOL_ID=

# Nutzer-ID mit Zugriff auf die administrative SQL-Konsole. Ohne Angabe bleibt
# die Konsole fuer alle gesperrt.
OWNER_USER_ID=

# Pfad zu einer Bootstrap-Rollenzuordnung fuer die Ersteinrichtung.
# Nur generische Rollen, keine echten Namen.
ROLE_MAP_PATH=

# Pfad zu einer JSON-Liste konfigurierter lokaler oder OIDC-Anmeldewege.
# Ohne Angabe startet die Installation nicht. Lokale Konten brauchen key,
# displayName und type=local; OIDC zusaetzlich issuerUrl, clientId und redirectUri.
AUTH_PROVIDERS_PATH=

# --- E-Mail-Konten ----------------------------------------------------------
# SMTP ist fuer Registrierung, E-Mail-Bestaetigung und Passwort-Reset Pflicht.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=
MAIL_FROM_NAME=
APP_BASE_URL=https://sani.beispielschule.de

# Web-Push (VAPID). Schluesselpaar erzeugen mit:
#   npx web-push generate-vapid-keys
# Der oeffentliche Schluessel gehoert zusaetzlich in die .env der App.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktangabe fuer den Push-Dienst, mailto: oder URL.
VAPID_SUBJECT=mailto:betreuung@beispielschule.de

# Token fuer Expo-Push (native Apps). Ohne Angabe wird kein Expo-Push versendet.
EXPO_ACCESS_TOKEN=

# URL einer LibreTranslate-Instanz fuer Uebersetzungen.
# Ohne Angabe: http://localhost:5000
LIBRETRANSLATE_URL=
