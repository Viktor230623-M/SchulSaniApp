{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "SchulSani",
        "EXPO_PUBLIC_THEME_COLOR": "#22C55E",
        "EXPO_PUBLIC_DOMAIN": "schulsaniapp.com",
        "APP_BUNDLE_ID": "com.schulsani.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "SchulSani",
        "EXPO_PUBLIC_THEME_COLOR": "#22C55E",
        "EXPO_PUBLIC_DOMAIN": "schulsaniapp.com",
        "APP_BUNDLE_ID": "com.schulsani.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "SchulSani",
        "EXPO_PUBLIC_THEME_COLOR": "#22C55E",
        "EXPO_PUBLIC_DOMAIN": "schulsaniapp.com",
        "APP_BUNDLE_ID": "com.schulsani.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "Viktor Gnjatic"
      }
    }
  }
}
