# Konfiguration der App fuer eine Instanz.
#
# Datei nach .env kopieren und ausfuellen. .env liegt nicht im Repository.
# Metro setzt EXPO_PUBLIC_*-Variablen beim Bauen als Text ins Bundle ein —
# zur Laufzeit sind sie nicht mehr aenderbar. Fehlt ein Pflichtwert, bricht
# der Start in der Entwicklung mit einer Meldung ab (siehe
# constants/appConfig.ts); vor einem Web-Export bricht
# scripts/generate-web-assets.js aus demselben Grund vorher ab.

# --- Pflicht -----------------------------------------------------------------

# Domain, unter der Web-App und API erreichbar sind, ohne Schema.
EXPO_PUBLIC_DOMAIN=sani.beispielschule.de

# Domain der IServ-Instanz der Schule, fuer den Anmeldebildschirm.
EXPO_PUBLIC_ISERV_DOMAIN=beispielschule.de

# Name des Sanitaetsdienstes, wie er im Anmeldebildschirm auftaucht.
EXPO_PUBLIC_SCHOOL_NAME=Schulsanitaetsdienst Beispielschule

# Kurzer Anwendungsname: Startbildschirm, PWA-Manifest, Benachrichtigungen.
EXPO_PUBLIC_APP_NAME=SchulSani

# Akzentfarbe der Instanz als Hex-Wert (Theme-Farbe, PWA-Manifest).
EXPO_PUBLIC_THEME_COLOR=#22C55E

# Bundle-ID/Package-Name der App. Nach einer Veroeffentlichung im App
# Store/Play Store nicht mehr aenderbar — pro Instanz eindeutig vergeben,
# z. B. com.beispielschule.sani.
APP_BUNDLE_ID=com.beispielschule.sani

# --- Optional ------------------------------------------------------------

# Oeffentlicher Web-Push-Schluessel (VAPID). Muss zum privaten Schluessel in
# der Backend-.env passen.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
