# nginx-Vorlage fuer SchulSani. Platzhalter in GROSSBUCHSTABEN mit spitzen
# Klammern werden von install.sh mit den konfigurierten Werten gerendert
# (Domain, HTTP-Port, Pfad zum Web-Export) und dann als Server-Block aktiviert.
#
# Die eigentlichen Locations liegen in /etc/nginx/schulsani/locations.conf
# (ebenfalls von install.sh gerendert) — so nutzt auch der nachtraeglich
# angehaengte TLS-Server-Block fuer benutzerdefinierte HTTPS-Ports denselben
# Inhalt, ohne dass ein zweiter Block gepflegt werden muss.
#
# Standard-Ports (80/443 frei): certbot --nginx ergaenzt danach automatisch
# die TLS-Direktiven direkt in diesem Block. Benutzerdefinierte Ports
# (--https-port / SCHULSANI_HTTPS_PORT): install.sh holt das Zertifikat mit
# certbot certonly --webroot (nginx bedient die Challenge auf Port 80) und
# haengt den TLS-Block separat an.
#
# Manuelle Verwendung (ohne install.sh):
#   sed -e 's#<DOMAIN>#sani.beispiel-schule.de#g' \
#       -e 's#<HTTP_PORT>#8080#g' \
#       ops/install/nginx.conf.template > /etc/nginx/sites-available/schulsani
#   ln -s /etc/nginx/sites-available/schulsani /etc/nginx/sites-enabled/schulsani

server {
    listen <HTTP_PORT>;
    listen [::]:<HTTP_PORT>;
    server_name <DOMAIN>;

    include /etc/nginx/schulsani/locations.conf;
}
