# nginx-Vorlage fuer SchulSani. Platzhalter in GROSSBUCHSTABEN mit spitzen
# Klammern werden vom Einrichtungsassistenten mit den abgefragten Werten
# gerendert (Domain, Pfad zum Web-Export) und dann als Server-Block aktiviert.
# certbot ergaenzt beim Beziehen des Zertifikats automatisch die
# TLS-Direktiven (listen 443, ssl_certificate, ...).
#
# Manuelle Verwendung (ohne Assistent):
#   sed -e 's#<DOMAIN>#sani.beispiel-schule.de#g' \
#       -e 's#<DIST_PATH>#/var/www/SchulSaniApp/artifacts/paramedic-app/dist#g' \
#       ops/install/nginx.conf.template > /etc/nginx/sites-available/schulsani
#   ln -s /etc/nginx/sites-available/schulsani /etc/nginx/sites-enabled/schulsani
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d <DOMAIN>

server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN>;

    root <DIST_PATH>;
    index index.html;

    client_max_body_size 10m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3002/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ~* \.(?:css|js|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
